{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/erjonb19/data-intake-platform/dip/contract.schema.json",
  "title": "Data intake contract",
  "type": "object",
  "required": ["feed", "version", "owner", "source", "format", "on_row_violation"],
  "additionalProperties": false,
  "properties": {
    "feed": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
    "version": {"type": "integer", "minimum": 1},
    "owner": {"type": "string"},
    "description": {"type": "string"},
    "classification": {"enum": ["public", "internal", "restricted"]},
    "source": {
      "type": "object",
      "required": ["channels", "filename_pattern"],
      "additionalProperties": false,
      "properties": {
        "channels": {"type": "array", "items": {"enum": ["sftp", "minio", "api"]}, "minItems": 1},
        "filename_pattern": {"type": "string"},
        "filename_date": {
          "type": "object",
          "required": ["regex", "format"],
          "additionalProperties": false,
          "properties": {
            "regex": {"type": "string"},
            "format": {"type": "string"},
            "max_days_before_received": {"type": "integer", "minimum": 0},
            "max_days_after_received": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "format": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["csv", "excel", "x12", "pdf", "fhir_bundle"]},
        "fhir_version": {"enum": ["R4"]},
        "bundle_types": {"type": "array", "items": {"type": "string"}},
        "delimiter": {"type": "string", "minLength": 1, "maxLength": 1},
        "encoding": {"type": "string"},
        "header": {"const": true},
        "quotechar": {"type": "string", "minLength": 1, "maxLength": 1},
        "sheet": {"type": "string", "minLength": 1},
        "header_row": {"type": "integer", "minimum": 1},
        "min_ocr_confidence": {"type": "number", "minimum": 0, "maximum": 100},
        "ocr_dpi": {"type": "integer", "minimum": 72, "maximum": 600},
        "transaction": {"enum": ["837", "835"]},
        "version": {"type": "string", "pattern": "^[0-9]{6}X[0-9]{3}(A[0-9])?$"},
        "fields": {"type": "object", "additionalProperties": {
          "anyOf": [{"type": "string", "minLength": 1},
                    {"type": "object", "properties": {"first_line": {"const": true}},
                     "required": ["first_line"], "additionalProperties": false}]}}
      }
    },
    "expected_arrival": {
      "type": "object",
      "properties": {"cron": {"type": "string"}, "grace": {"type": "string"}}
    },
    "on_row_violation": {"enum": ["quarantine_row", "reject_file"]},
    "max_bad_row_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "allow_extra_columns": {"type": "boolean"},
    "min_rows": {"type": "integer", "minimum": 0},
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "type": {"enum": ["string", "integer", "decimal", "date", "boolean"]},
          "description": {"type": "string"},
          "required": {"type": "boolean"},
          "unique": {"type": "boolean"},
          "pattern": {"type": "string"},
          "allowed": {"type": "array", "minItems": 1},
          "min": {},
          "max": {},
          "phi": {"type": "boolean"}
        }
      }
    },
    "model": {
      "description": "Stage 10 (S10.3): the gold model dip generates for a CSV or Excel feed (dip/dbt_gen.py). latest_per_key keeps the newest row per key; all_rows keeps every row. Without it, only the silver model is generated.",
      "type": "object",
      "required": ["grain"],
      "additionalProperties": false,
      "properties": {
        "grain": {"enum": ["latest_per_key", "all_rows"]},
        "key": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
      }
    },
    "fhir": {
      "type": "object",
      "required": ["patient_resource", "load", "resources"],
      "additionalProperties": false,
      "properties": {
        "patient_resource": {"type": "string"},
        "load": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "resources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "required": {"type": "array", "items": {"type": "string"}},
              "allowed": {"type": "object", "additionalProperties": {"type": "array"}},
              "required_one_of": {"type": "array", "items": {"type": "string"}, "minItems": 2},
              "code_systems": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "dates": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "references": {"type": "object", "additionalProperties": {"type": "string"}},
        "date_window": {
          "type": "object",
          "required": ["min", "max"],
          "additionalProperties": false,
          "properties": {"min": {"type": "string"}, "max": {"type": "string"}}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"format": {"properties": {"type": {"const": "fhir_bundle"}}}}},
      "then": {"required": ["fhir"]}
    },
    {
      "if": {"properties": {"format": {"properties": {"type": {"const": "csv"}}}}},
      "then": {"required": ["columns"]}
    },
    {
      "if": {"properties": {"format": {"properties": {"type": {"const": "x12"}}}}},
      "then": {"required": ["columns"],
               "properties": {"format": {"required": ["transaction", "version"]}}}
    }
  ]
}
