    "input": {
     "contract_yaml": "# Laboratory results from a vendor lab: one row per resulted test, one file per day.\nfeed: healthcare.lab_results\nversion: 1\nowner: vendor-ops@example.com\ndescription: >\n  Daily file of resulted laboratory tests: the result identifier, the patient reference,\n  the collection date, the LOINC test code, the value with its unit, the abnormal flag and\n  the ordering provider.\nclassification: restricted\nsource:\n  channels: [minio, sftp, api]\n  filename_pattern: \"lab_results_*.csv\"\n  filename_date:\n    regex: \"^lab_results_([0-9]+)\"\n    format: \"%Y%m%d\"\n    max_days_before_received: 7\n    max_days_after_received: 0\nformat: { type: csv, delimiter: \",\", encoding: utf-8, header: true }\nexpected_arrival: { cron: \"0 7 * * *\", grace: 2h }\non_row_violation: quarantine_row\nmax_bad_row_ratio: 0.05\nmin_rows: 1\ncolumns:\n  - { name: result_id, type: string, required: true, unique: true, pattern: \"^[A-Z]{2}[0-9]{6}$\" }\n  - { name: patient_ref, type: string, required: true, phi: true, pattern: \"^[a-z]{2}-[0-9]{4}$\" }\n  - { name: collected_date, type: date, required: true, min: \"2020-01-01\", max: today }\n  - { name: loinc_code, type: string, required: true, pattern: \"^[0-9]{3,4}-[0-9]$\" }\n  - { name: result_value, type: decimal, required: true, pattern: \"^[0-9]+(\\\\.[0-9]{1,2})?$\" }\n  - { name: unit, type: string, required: true, pattern: \"^(%|[a-z]{1,2}/[A-Za-z]{1,3})$\" }\n  - { name: abnormal_flag, type: string, required: true, allowed: [H, L, N] }\n  - { name: ordering_provider, type: string, phi: true }\n",
     "feed": "healthcare.lab_results",
