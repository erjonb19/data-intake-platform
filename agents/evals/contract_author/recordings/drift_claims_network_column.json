    "input": {
     "contract_yaml": "# Paid claim lines from a (synthetic) payer: one row per billed line, one file per day.\n# Generated from the Synthea patients' ExplanationOfBenefit resources by\n# packs/healthcare/generators/claims.py (Stage 2, S2.4).\nfeed: healthcare.claims\nversion: 2\nowner: vendor-ops@example.com\ndescription: >\n  Daily file of adjudicated claim lines: the member, the service, where it happened, and\n  the billed, allowed and paid amounts. All data is synthetic.\nclassification: restricted\nsource:\n  channels: [minio, sftp, api]\n  filename_pattern: \"claims_*.csv\"\n  # The business date in the name (claims_YYYYMMDD.csv): a real date, not after the day it\n  # was received and at most 7 days before; otherwise FILE.NAME_DATE.\n  filename_date:\n    regex: \"^claims_([0-9]+)\"\n    format: \"%Y%m%d\"\n    max_days_before_received: 7\n    max_days_after_received: 0\nformat: { type: csv, delimiter: \",\", encoding: utf-8, header: true }\nexpected_arrival: { cron: \"0 7 * * *\", grace: 2h }\non_row_violation: quarantine_row\nmax_bad_row_ratio: 0.02\n# Amounts have at most 2 decimals (pattern below): gold stores numeric(12,2), and a\n# third decimal would otherwise be rounded away without anyone noticing.\nmin_rows: 1\ncolumns:\n  - { name: claim_line_id, type: string, required: true, unique: true, pattern: \"^[0-9a-f-]{36}-[0-9]{1,3}$\" }\n  - { name: claim_id, type: string, required: true, pattern: \"^[0-9a-f-]{36}$\" }\n  - { name: line_number, type: integer, required: true, min: 1, max: 999 }\n  - { name: member_id, type: string, required: true, pattern: \"^M[0-9]{9}$\" }\n  - { name: service_date, type: date, required: true, min: \"2020-01-01\", max: today }\n  - name: place_of_service\n    type: string\n    required: true\n    pattern: \"^[0-9]{2}$\"\n    description: CMS place-of-service code (11 office, 19/22 outpatient, 21 inpatient, 23 ER, ...)\n  - { name: procedure_code, type: string, required: true, pattern: \"^[A-Za-z0-9.-]{1,20}$\" }\n  - { name: procedure_system, type: string, required: true, allowed: [SNOMED, CDT, LOINC, CVX, LOCAL] }\n  - { name: billed_amount, type: decimal, required: true, min: 0, max: 10000000, pattern: \"^[0-9]+(\\\\.[0-9]{1,2})?$\" }\n  - { name: allowed_amount, type: decimal, required: true, min: 0, max: 10000000, pattern: \"^[0-9]+(\\\\.[0-9]{1,2})?$\" }\n  - { name: paid_amount, type: decimal, required: true, min: 0, max: 10000000, pattern: \"^[0-9]+(\\\\.[0-9]{1,2})?$\" }\n  - { name: coinsurance_amount, type: decimal, required: true, min: 0, max: 10000000, pattern: \"^[0-9]+(\\\\.[0-9]{1,2})?$\" }\n  - { name: deductible_amount, type: decimal, required: true, min: 0, max: 10000000, pattern: \"^[0-9]+(\\\\.[0-9]{1,2})?$\" }\n  - { name: payer, type: string, required: true }\n  - { name: network_status, type: string, allowed: [IN] }\n",
