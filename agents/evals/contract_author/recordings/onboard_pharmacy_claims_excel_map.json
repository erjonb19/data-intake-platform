     "contract_yaml": "# Pharmacy claim lines from a vendor: one row per dispensed prescription, one file per day.\n# Onboarded from intake job 1 (pharmacy_claims_20261019.xlsx, sheet Claims).\nfeed: healthcare.pharmacy_claims\nversion: 1\nowner: vendor-ops@example.com\ndescription: >\n  Daily file of pharmacy claim lines: the member, the fill date, the drug (NDC), days supply,\n  quantity, the paid amount and the dispensing pharmacy (NPI).\nclassification: restricted\nsource:\n  channels: [minio, sftp, api]\n  filename_pattern: \"pharmacy_claims_*.xlsx\"\n  # The business date in the name (pharmacy_claims_YYYYMMDD.xlsx): a real date, not after the\n  # day it was received and at most 7 days before; otherwise FILE.NAME_DATE.\n  filename_date:\n    regex: \"^pharmacy_claims_([0-9]+)\"\n    format: \"%Y%m%d\"\n    max_days_before_received: 7\n    max_days_after_received: 0\nformat: { type: excel, sheet: Claims, header_row: 1 }\nexpected_arrival: { cron: \"0 7 * * *\", grace: 2h }\non_row_violation: quarantine_row\nmax_bad_row_ratio: 0.05\nmin_rows: 1\ncolumns:\n  - { name: rx_claim_id, type: string, required: true, unique: true, pattern: \"^[A-Za-z]{2}[0-9]{6}$\", phi: true }\n  - { name: member_id, type: string, required: true, pattern: \"^[A-Za-z][0-9]{9}$\", phi: true }\n  - { name: fill_date, type: date, required: true, phi: true }\n  - { name: ndc, type: string, required: true, pattern: \"^[0-9]{11}$\" }\n  - { name: days_supply, type: integer, required: true, allowed: [30, 60, 90] }\n  - { name: quantity, type: integer, required: true, allowed: [30, 60, 90, 120] }\n  - { name: paid_amount, type: decimal, required: true, min: 0, max: 10000000, pattern: \"^[0-9]+(\\\\.[0-9]{1,2})?$\" }\n  - { name: pharmacy_npi, type: string, required: true, pattern: \"^[0-9]{10}$\" }\n",
