    "input": {
     "contract_yaml": "# Provider directory from a vendor: one row per provider location, one file per day.\nfeed: healthcare.provider_roster\nversion: 1\nowner: vendor-ops@example.com\ndescription: >\n  Daily provider roster: each provider's NPI, name, taxonomy, practice state and whether\n  they accept new patients. Onboarded from a sample file; the expected arrival time is a\n  placeholder to confirm with the vendor.\nclassification: restricted\nsource:\n  channels: [minio, sftp, api]\n  filename_pattern: \"provider_roster_*.csv\"\n  # The business date in the name (provider_roster_YYYYMMDD.csv): a real date, not after the\n  # day it was received and at most 7 days before; otherwise FILE.NAME_DATE.\n  filename_date:\n    regex: \"^provider_roster_([0-9]+)\"\n    format: \"%Y%m%d\"\n    max_days_before_received: 7\n    max_days_after_received: 0\nformat: { type: csv, delimiter: \",\", encoding: utf-8, header: true }\nexpected_arrival: { cron: \"0 6 * * *\", grace: 2h }\non_row_violation: quarantine_row\nmax_bad_row_ratio: 0.05          # above this, the whole file is rejected\nmin_rows: 1\ncolumns:\n  - { name: npi, type: string, required: true, unique: true, pattern: \"^[0-9]{10}$\" }\n  - { name: provider_first_name, type: string, required: true, phi: true }\n  - { name: provider_last_name, type: string, required: true, phi: true }\n  - { name: taxonomy_code, type: string, required: true, pattern: \"^[0-9]{3}[A-Z][0-9]{5}[A-Z]$\" }\n  - { name: practice_state, type: string, required: true, allowed: [CT, NJ, NY] }\n  - { name: accepting_new_patients, type: string, required: true, allowed: [N, Y] }\n  - { name: effective_date, type: date, required: true, max: today }\n",
