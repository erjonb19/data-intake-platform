     "contract_yaml": "# Member eligibility from a (synthetic) payer: one row per member, one file per day.\n# Generated from the Synthea patients by packs/healthcare/generators/eligibility.py.\nfeed: healthcare.eligibility\nversion: 1\nowner: vendor-ops@example.com\ndescription: >\n  Daily full eligibility file: every enrolled member with their plan and coverage dates.\n  All data is synthetic.\nclassification: restricted\nsource:\n  channels: [minio, sftp, api]\n  filename_pattern: \"elig_*.csv\"\n  # The business date in the name (elig_YYYYMMDD.csv). It must be a real date, not after\n  # the day the file was received, and at most 7 days before it; otherwise the file is\n  # quarantined (FILE.NAME_DATE). A name with no digits takes the date it was received.\n  filename_date:\n    regex: \"^elig_([0-9]+)\"\n    format: \"%Y%m%d\"\n    max_days_before_received: 7\n    max_days_after_received: 0\nformat: { type: csv, delimiter: \",\", encoding: utf-8, header: true }\nexpected_arrival: { cron: \"0 6 * * *\", grace: 2h }\non_row_violation: quarantine_row\nmax_bad_row_ratio: 0.05          # above this, the whole file is rejected\nmin_rows: 1\ncolumns:\n  - { name: member_id, type: string, required: true, unique: true, pattern: \"^M[0-9]{9}$\" }\n  - { name: first_name, type: string, required: true, phi: true }\n  - { name: last_name, type: string, required: true, phi: true }\n  - { name: dob, type: date, required: true, min: \"1900-01-01\", max: today, phi: true }\n  - { name: sex, type: string, required: true, allowed: [F, M, U] }\n  - { name: plan_code, type: string, required: true, allowed: [HMO, PPO, EPO, HDHP] }\n  - { name: coverage_start, type: date, required: true, min: \"1990-01-01\" }\n  - { name: coverage_end, type: date, description: \"Empty while coverage is open\" }\n  - name: patient_ref\n    type: string\n    description: The payer's link to the clinical record (here the Synthea patient id)\n    phi: true\n",
     "feed": "healthcare.eligibility",
