    "input": {
     "contract_yaml": "# Pharmacy claim lines from a vendor: one row per dispensed prescription, one file per day.\n# Onboarded from pharmacy_claims_20261019.xlsx (sheet Claims). Owner, channels and arrival\n# schedule are placeholders copied from healthcare.claims and need confirmation.\nfeed: healthcare.pharmacy_claims\nversion: 1\nowner: vendor-ops@example.com\ndescription: >\n  Daily file of dispensed pharmacy claims: the rx claim, the member, the fill date, the\n  drug (NDC), the days supply and quantity, the paid amount and the dispensing pharmacy.\n  All data is synthetic.\nclassification: restricted\nsource:\n  channels: [minio, sftp, api]\n  filename_pattern: \"pharmacy_claims_*.xlsx\"\n  # The business date in the name (pharmacy_claims_YYYYMMDD.xlsx): a real date, not after\n  # the day it was received and at most 7 days before; otherwise FILE.NAME_DATE.\n  filename_date:\n    regex: \"^pharmacy_claims_([0-9]+)\"\n    format: \"%Y%m%d\"\n    max_days_before_received: 7\n    max_days_after_received: 0\nformat: { type: excel, sheet: Claims, header_row: 1 }\nexpected_arrival: { cron: \"0 7 * * *\", grace: 2h }\non_row_violation: quarantine_row\nmax_bad_row_ratio: 0.05\nmin_rows: 1\ncolumns:\n  - { name: rx_claim_id, type: string, required: true, unique: true, pattern: \"^[A-Z]{2}[0-9]{6}$\" }\n  - { name: member_id, type: string, required: true, phi: true, pattern: \"^[A-Z][0-9]{9}$\" }\n  - { name: fill_date, type: date, required: true, phi: true, min: \"2020-01-01\", max: today }\n  # NDC kept as a string so that a leading zero is never lost.\n  - { name: ndc, type: string, required: true, pattern: \"^[0-9]{11}$\" }\n  - { name: days_supply, type: integer, required: true, allowed: [30, 60, 90] }\n  - { name: quantity, type: integer, required: true, min: 1, max: 999 }\n  - { name: paid_amount, type: decimal, required: true, min: 0, max: 10000000, pattern: \"^[0-9]+(\\\\.[0-9]{1,2})?$\" }\n  # NPI kept as a string (10 digits, identifier, not arithmetic).\n  - { name: pharmacy_npi, type: string, required: true, pattern: \"^[0-9]{10}$\" }\n",
     "feed": "healthcare.pharmacy_claims",
