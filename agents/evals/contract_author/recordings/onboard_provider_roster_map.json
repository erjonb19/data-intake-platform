     "contract_yaml": "# Provider roster from a vendor: one row per provider practising at a site, one file per day.\nfeed: healthcare.provider_roster\nversion: 1\nowner: vendor-ops@example.com\ndescription: >\n  Daily provider roster: each provider's NPI, name, taxonomy (specialty) code, practice\n  state, whether they accept new patients, and the effective date of the listing.\nclassification: restricted\nsource:\n  channels: [minio, sftp, api]\n  filename_pattern: \"provider_roster_*.csv\"\n  # The business date in the name (provider_roster_YYYYMMDD.csv). It must be a real date, not\n  # after the day the file was received, and at most 7 days before it; otherwise the file is\n  # quarantined (FILE.NAME_DATE). A name with no digits takes the date it was received.\n  filename_date:\n    regex: \"^provider_roster_([0-9]+)\"\n    format: \"%Y%m%d\"\n    max_days_before_received: 7\n    max_days_after_received: 0\nformat: { type: csv, delimiter: \",\", encoding: utf-8, header: true }\nexpected_arrival: { cron: \"0 6 * * *\", grace: 2h }\non_row_violation: quarantine_row\nmax_bad_row_ratio: 0.05          # above this, the whole file is rejected\nmin_rows: 1\ncolumns:\n  - { name: npi, type: string, required: true, unique: true, pattern: \"^[0-9]{10}$\", phi: true }\n  - { name: provider_first_name, type: string, phi: true }\n  - { name: provider_last_name, type: string, phi: true }\n  - { name: taxonomy_code, type: string, required: true, pattern: \"^[0-9]{3}[A-Z][0-9]{5}[A-Z]$\" }\n  - { name: practice_state, type: string, required: true, allowed: [CT, NJ, NY] }\n  - { name: accepting_new_patients, type: string, required: true, allowed: [N, Y] }\n  - { name: effective_date, type: date, required: true }\n",
