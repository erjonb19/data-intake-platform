     "contract_yaml": "# Provider roster from a vendor: one row per provider.\nfeed: healthcare.provider_roster\nversion: 1\nowner: vendor-ops@example.com\ndescription: >\n  Provider roster: one row per provider with NPI, taxonomy, practice state and\n  whether the provider is accepting new patients.\nclassification: restricted\nsource:\n  channels: [minio, sftp, api]\n  filename_pattern: \"provider_roster*.csv\"\nformat: { type: csv, delimiter: \",\", encoding: utf-8, header: true }\nexpected_arrival: { cron: \"0 6 * * *\", grace: 2h }\non_row_violation: quarantine_row\nmax_bad_row_ratio: 0.05          # above this, the whole file is rejected\nmin_rows: 1\ncolumns:\n  - { name: npi, type: integer, required: true, unique: true, phi: true }\n  - { name: provider_first_name, type: string, required: true, phi: true }\n  - { name: provider_last_name, type: string, required: true, phi: true }\n  - { name: taxonomy_code, type: string, required: true, pattern: \"^[0-9]{3}[A-Z][0-9]{5}[A-Z]$\" }\n  - { name: practice_state, type: string, required: true, allowed: [CT, NJ, NY] }\n  - { name: accepting_new_patients, type: string, required: true, allowed: [N, Y] }\n  - { name: effective_date, type: date, required: true }\n",
