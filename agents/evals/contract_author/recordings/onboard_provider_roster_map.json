     "contract_yaml": "feed: healthcare.provider_roster\nversion: 1\nowner: vendor-ops@example.com\ndescription: >\n  Provider roster from the vendor: one row per provider with NPI, practice state,\n  whether the provider is accepting new patients, and the effective date.\nclassification: restricted\nsource:\n  channels: [minio, sftp, api]\n  filename_pattern: \"provider_roster_*.csv\"\n  filename_date:\n    regex: \"^provider_roster_([0-9]+)\"\n    format: \"%Y%m%d\"\n    max_days_before_received: 7\n    max_days_after_received: 0\nformat: { type: csv, delimiter: \",\", encoding: utf-8, header: true }\nexpected_arrival: { cron: \"0 6 * * *\", grace: 2h }\non_row_violation: quarantine_row\nmax_bad_row_ratio: 0.05\nmin_rows: 1\ncolumns:\n  - { name: npi, type: integer, required: true, unique: true, pattern: \"^[0-9]{10}$\", phi: true }\n  - { name: provider_first_name, type: string, phi: true }\n  - { name: provider_last_name, type: string, phi: true }\n  - { name: taxonomy_code, type: string, pattern: \"^[0-9]{3}[A-Z][0-9]{5}[A-Z]$\" }\n  - { name: practice_state, type: string, allowed: [CT, NJ, NY] }\n  - { name: accepting_new_patients, type: string, allowed: [N, Y] }\n  - { name: effective_date, type: date, required: true }\n",
