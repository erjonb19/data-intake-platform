     "contract_yaml": "# Lab results from a vendor lab: one row per result, one file per day.\nfeed: healthcare.lab_results\nversion: 1\nowner: vendor-ops@example.com\ndescription: >\n  Daily file of lab results: the result, the patient reference, the collection date,\n  the LOINC code, the value with its unit, the abnormal flag and the ordering provider.\nclassification: restricted\nsource:\n  channels: [minio, sftp, api]\n  filename_pattern: \"lab_results_*.csv\"\n  # The business date in the name (lab_results_YYYYMMDD.csv): a real date, not after the day it\n  # was received and at most 7 days before; otherwise FILE.NAME_DATE.\n  filename_date:\n    regex: \"^lab_results_([0-9]+)\"\n    format: \"%Y%m%d\"\n    max_days_before_received: 7\n    max_days_after_received: 0\nformat: { type: csv, delimiter: \",\", encoding: utf-8, header: true }\nexpected_arrival: { cron: \"0 7 * * *\", grace: 2h }\non_row_violation: quarantine_row\nmax_bad_row_ratio: 0.05\nmin_rows: 1\ncolumns:\n  - { name: result_id, type: string, required: true, unique: true, phi: true, pattern: '^[A-Z]{2}[0-9]{6}$' }\n  - { name: patient_ref, type: string, required: true, phi: true, pattern: '^[a-z]{2}-[0-9]{4}$' }\n  - { name: collected_date, type: date, required: true, max: today, phi: true }\n  - { name: loinc_code, type: string, required: true, pattern: '^[0-9]{3,4}-[0-9]$' }\n  - { name: result_value, type: decimal, required: true, min: 0, pattern: '^[0-9]{1,3}\\.[0-9]$' }\n  - { name: unit, type: string, required: true, pattern: '^(%|[a-z]{1,2}/[A-Za-z]{1,2})$' }\n  - { name: abnormal_flag, type: string, required: true, allowed: [H, L, N] }\n  - { name: ordering_provider, type: string, phi: true }\n",
