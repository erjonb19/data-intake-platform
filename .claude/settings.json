{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/.kube/**)",
      "Read(**/kubeconfig*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push * --tags*)",
      "Bash(git branch -D *)",
      "Bash(gh pr merge * --delete-branch*)",
      "Bash(gh release *)",
      "Bash(gh repo delete *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(Remove-Item * -Recurse*)",
      "PowerShell(Get-Content *.env*)",
      "Bash(git tag *)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push --tags*)",
      "Bash(git push * refs/tags/*)",
      "PowerShell(git tag *)",
      "PowerShell(git push * main)",
      "PowerShell(git push * HEAD:main*)",
      "PowerShell(git push --tags*)",
      "PowerShell(git push * --tags*)",
      "PowerShell(git push * refs/tags/*)"
    ],
    "ask": [
      "Bash(pip install *)",
      "Bash(uv add *)",
      "Bash(uv pip install *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(pnpm add *)",
      "Bash(npx *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl apply *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(docker run *)",
      "Bash(wget *)",
      "PowerShell(pip install *)",
      "PowerShell(terraform apply *)",
      "PowerShell(kubectl delete *)",
      "WebFetch"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git push)",
      "Bash(git push -u origin *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr view *)",
      "Bash(gh run view *)",
      "Bash(pytest *)",
      "Bash(ruff check *)",
      "Bash(ruff format --check *)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.astral.sh)",
      "WebFetch(domain:pip.pypa.io)",
      "WebFetch(domain:airflow.apache.org)"
    ]
  }
}
