-- Sets the cohort reader's password from the environment (psql 15+ \getenv), after
-- postgres-roles.sql. The statement carries the password, so this session turns statement
-- and error-statement logging off first (superuser only). Without the variable, the role
-- keeps its current password (none on a fresh install: it cannot log in).
\getenv cohort_pw COHORT_READER_PASSWORD
\if :{?cohort_pw}
SET log_statement = 'none';
SET log_min_error_statement = 'panic';
SET log_min_duration_statement = -1;
ALTER ROLE dip_cohort_reader PASSWORD :'cohort_pw';
RESET log_statement;
RESET log_min_error_statement;
RESET log_min_duration_statement;
\else
\echo 'COHORT_READER_PASSWORD not set: dip_cohort_reader password unchanged'
\endif
